---
import Base from './Base.astro';
import SeriesNav from '../components/SeriesNav.astro';
import { getSeries } from '../data/series';

interface Props {
	title: string;
	part: number;
	date: string;
	series?: string;
}

const { title, part, date, series = 'myair-bridge' } = Astro.props;

const currentSeries = getSeries(series);
const parts = currentSeries.parts;
const hub = currentSeries.hub;
const hubTitle = currentSeries.title;

const prev = part > 1 ? { href: currentSeries.partHref(parts[part - 2]), title: parts[part - 2].title } : undefined;
const next = part < parts.length ? { href: currentSeries.partHref(parts[part]), title: parts[part].title } : undefined;
---

<Base title={title}>
	<p><a href={hub}>← {hubTitle}</a></p>
	<div class="post-meta">
		<span class="badge">part {part} of {parts.length}</span>
		<span class="badge">{date}</span>
	</div>
	<h1>{title}</h1>
	<SeriesNav hub={hub} prev={prev} next={next} />
	<slot />
	<SeriesNav hub={hub} prev={prev} next={next} />
</Base>
