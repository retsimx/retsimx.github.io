		end

		subgraph protocol["Protocol & Network Stack"]
			GATT["GATT Server<br/>(ble_ll_attribute.rs)"]
			PAIR["Pairing Engine<br/>(ble_ll_pair.rs)"]
			MESH["Mesh Packet Engine<br/>(light_ll / Flood Relay)"]
			CRYPTO["AES-CCM & Key Derivation<br/>(crypto.rs)"]
		end

		subgraph hal["Hardware Abstraction Layer (HAL)"]
